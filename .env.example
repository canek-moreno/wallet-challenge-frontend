# URL base de la API para el servidor (Server Components y Route Handlers).
# El cliente siempre usa /api.
API_BASE_URL=http://localhost:3000/api

# Activa la API simulada en app/api. Debe ser false o estar ausente en producción.
ENABLE_MOCK_API=true

# Centro de ayuda y correo de soporte que muestra el módulo Ayuda. Opcionales.
NEXT_PUBLIC_HELP_CENTER_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
